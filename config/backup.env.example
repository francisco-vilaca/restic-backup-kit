# restic-backup-kit configuration
# Installed as /etc/restic-backup-kit/backup.env (mode 600). Read by restic-backup
# and restic-restore-test. Any RESTIC_* variable supported by restic works here.

# ---- Where backups go ---------------------------------------------------------
# Local disk / NAS mount:   /mnt/backup/restic
# SFTP:                     sftp:backup@nas.example.com:/srv/restic/myserver
# S3 / Backblaze B2 / Wasabi (S3 API):
#                           s3:https://s3.us-west-002.backblazeb2.com/my-bucket/myserver
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
RESTIC_REPOSITORY=/mnt/backup/restic

# The repository password. KEEP A COPY OUTSIDE THIS SERVER: without it the
# backups cannot be decrypted, by anyone, ever.
RESTIC_PASSWORD_FILE=/etc/restic-backup-kit/password

# ---- What to back up (space separated) ----------------------------------------
BACKUP_PATHS="/etc /home /root /var/www /srv"
EXCLUDE_FILE=/etc/restic-backup-kit/excludes.txt
# Stay on one filesystem per path (skips /proc-like mounts under backed-up paths)
ONE_FILE_SYSTEM=yes
# Treat "some files could not be read" as a failure (recommended)
ALLOW_INCOMPLETE=no

# Optional command run before the backup, e.g. a consistent database dump:
# PRE_BACKUP_HOOK="mysqldump --all-databases --single-transaction > /var/backups/mysql.sql"
# PRE_BACKUP_HOOK="sudo -u postgres pg_dumpall > /var/backups/postgres.sql"
PRE_BACKUP_HOOK=

# ---- Retention ------------------------------------------------------------------
KEEP_LAST=3
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Verify part of the stored data after each backup (empty = skip; e.g. 1%)
CHECK_READ_DATA_SUBSET=

# ---- Restore test ---------------------------------------------------------------
RESTORE_TEST_FILES=20            # random files restored and compared each run
RESTORE_TEST_MAX_AGE_HOURS=26    # alert if the newest snapshot is older than this
RESTORE_TEST_CHECK_SUBSET=2%     # share of repository data re-read and verified

# ---- Monitoring (optional) -------------------------------------------------------
# healthchecks.io-compatible URLs; /start and /fail are appended automatically.
# You get an alert when a run fails AND when a run never happens.
HEALTHCHECK_URL=
RESTORE_TEST_HEALTHCHECK_URL=
