#!/usr/bin/env bash
# restic-backup: run one backup + retention cycle from a config file.
# Part of restic-backup-kit (MIT) - https://github.com/francisco-vilaca/restic-backup-kit
#
#   restic-backup            run backup, forget/prune and (optionally) check
#   restic-backup --init     create the repository first if it does not exist
#
# Config: /etc/restic-backup-kit/backup.env (override with RESTIC_KIT_CONFIG).

set -Eeuo pipefail

VERSION="0.1.0"
CONFIG="${RESTIC_KIT_CONFIG:-/etc/restic-backup-kit/backup.env}"
INIT=0

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }
die() { log "ERROR: $*" >&2; hc_ping /fail "$*"; exit 1; }

# healthchecks.io-style pings: <url>/start, <url> (success), <url>/fail
hc_ping() {
  [[ -n ${HEALTHCHECK_URL:-} ]] || return 0
  curl -fsS -m 10 --retry 3 -o /dev/null --data-raw "${2:-}" "${HEALTHCHECK_URL%/}$1" 2>/dev/null \
    || log "warning: healthcheck ping failed"
}

for arg in "$@"; do
  case $arg in
    --init) INIT=1 ;;
    --version) echo "restic-backup $VERSION"; exit 0 ;;
    -h | --help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

[[ -r $CONFIG ]] || { echo "config not found or not readable: $CONFIG" >&2; exit 2; }
set -a
# shellcheck disable=SC1090
. "$CONFIG"
set +a

: "${RESTIC_REPOSITORY:?set RESTIC_REPOSITORY in $CONFIG}"
: "${BACKUP_PATHS:?set BACKUP_PATHS in $CONFIG}"
[[ -n ${RESTIC_PASSWORD_FILE:-}${RESTIC_PASSWORD:-} ]] || die "set RESTIC_PASSWORD_FILE in $CONFIG"
command -v restic >/dev/null || die "restic is not installed"

# Never run two backups at the same time (a slow run + the next timer).
LOCK_FILE="${LOCK_FILE:-/run/lock/restic-backup-kit.lock}"
[[ -w $(dirname "$LOCK_FILE") ]] || LOCK_FILE="${TMPDIR:-/tmp}/restic-backup-kit.lock"
exec 9>"$LOCK_FILE"
flock -n 9 || { log "another backup is still running, skipping this run"; exit 0; }

trap 'die "failed at line $LINENO"' ERR
hc_ping /start
log "restic-backup $VERSION: repository $RESTIC_REPOSITORY"

if ! restic cat config >/dev/null 2>&1; then
  if ((INIT)); then
    log "initializing new repository"
    restic init
  else
    die "repository not reachable or not initialized (run once with --init)"
  fi
fi

if [[ -n ${PRE_BACKUP_HOOK:-} ]]; then
  log "running pre-backup hook"
  bash -c "$PRE_BACKUP_HOOK"
fi

read -r -a wanted <<<"$BACKUP_PATHS"
paths=()
for p in "${wanted[@]}"; do
  if [[ -e $p ]]; then paths+=("$p"); else log "warning: $p does not exist, skipping it"; fi
done
((${#paths[@]})) || die "none of BACKUP_PATHS exist: $BACKUP_PATHS"
args=(--tag restic-backup-kit --exclude-caches)
[[ -n ${EXCLUDE_FILE:-} && -r ${EXCLUDE_FILE:-} ]] && args+=(--exclude-file "$EXCLUDE_FILE")
[[ ${ONE_FILE_SYSTEM:-yes} == yes ]] && args+=(--one-file-system)

log "backing up: ${paths[*]}"
set +e
restic backup "${args[@]}" "${paths[@]}"
rc=$?
set -e
if ((rc == 3)); then
  # restic created the snapshot but some files could not be read
  [[ ${ALLOW_INCOMPLETE:-no} == yes ]] || die "snapshot is incomplete: some files could not be read"
  log "warning: some files could not be read (ALLOW_INCOMPLETE=yes)"
elif ((rc != 0)); then
  die "restic backup exited with code $rc"
fi

log "applying retention: last ${KEEP_LAST:-3}, daily ${KEEP_DAILY:-7}, weekly ${KEEP_WEEKLY:-4}, monthly ${KEEP_MONTHLY:-6}"
restic forget --tag restic-backup-kit --prune \
  --keep-last "${KEEP_LAST:-3}" --keep-daily "${KEEP_DAILY:-7}" \
  --keep-weekly "${KEEP_WEEKLY:-4}" --keep-monthly "${KEEP_MONTHLY:-6}"

if [[ -n ${CHECK_READ_DATA_SUBSET:-} ]]; then
  log "checking repository (read-data-subset=$CHECK_READ_DATA_SUBSET)"
  restic check --read-data-subset="$CHECK_READ_DATA_SUBSET"
fi

trap - ERR
hc_ping "" "backup ok"
log "backup finished successfully"
